---
import { url, media } from "../lib/text";
interface Props {
  work: { title: string; slug: string; thumbnail: string; tagline?: string; coverVideo?: string; services?: string[]; showOnHomepage?: boolean };
  eager?: boolean;
  hidden?: boolean;
  categories?: string[]; /* overrides work.services for filtering (homepage selection) */
}
const { work, eager = false, hidden = false, categories } = Astro.props;
---

<a class="work-card tile reveal" href={url(`/works/${work.slug}`)} data-services={(categories ?? work.services ?? []).join(" ")} data-featured={String(!!work.showOnHomepage)} hidden={hidden}>
  {work.coverVideo ? (
    <video src={media(work.coverVideo)} poster={media(work.thumbnail)} autoplay muted loop playsinline preload="metadata" aria-label={work.title} />
  ) : (
    <img src={media(work.thumbnail)} alt={work.title} loading={eager ? "eager" : "lazy"} />
  )}
  <span class="work-card__overlay" aria-hidden="true">
    <span class="work-card__top">
      <span class="h3">{work.title}</span>
      <span class="upper underline">View project</span>
    </span>
    {work.tagline && <span class="work-card__tagline">{work.tagline}</span>}
  </span>
</a>

<style>
  .work-card {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--bg);
  }
  /* Same look as an opened Services card. There is no separate white layer over the image
     (that caused a hairline at the edges on 125%/150% screens): the image itself fades out
     on the white card, which gives the same translucent-white result. */
  .work-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px 20px;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .work-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .work-card__top .underline {
    flex: none;
  }
  /* One sentence across the full card width (body text style), max 2 lines */
  .work-card__tagline {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }
  .work-card img,
  .work-card video {
    transition: transform 0.6s var(--ease), opacity 0.35s;
  }
  .work-card:hover img,
  .work-card:hover video,
  .work-card:focus-visible img,
  .work-card:focus-visible video {
    opacity: var(--fade-to);
  }
  .work-card:hover .work-card__overlay,
  .work-card:focus-visible .work-card__overlay {
    opacity: 1;
  }
</style>
