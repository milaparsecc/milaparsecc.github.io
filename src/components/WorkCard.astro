---
import { url, media } from "../lib/text";
interface Props {
  work: { title: string; slug: string; thumbnail: string; services?: string[] };
  eager?: boolean;
}
const { work, eager = false } = Astro.props;
---

<a class="work-card tile reveal" href={url(`/works/${work.slug}`)} data-services={(work.services ?? []).join(" ")}>
  <img src={media(work.thumbnail)} alt={work.title} loading={eager ? "eager" : "lazy"} />
  <span class="work-card__title upper">{work.title}</span>
</a>

<style>
  .work-card {
    display: block;
    aspect-ratio: 16 / 9;
  }
  /* White label — mirror of the black "Get in touch" button (same height, type, no radius).
     On hover it slides up from under the card edge together with the image zoom. */
  .work-card__title {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 16px;
    background: var(--bg);
    color: var(--text);
    transform: translateY(100%);
    transition: transform 0.6s var(--ease);
  }
  .work-card:hover .work-card__title,
  .work-card:focus-visible .work-card__title {
    transform: none;
  }
  /* Touch screens have no hover: keep the label visible */
  @media (hover: none) {
    .work-card__title { transform: none; }
  }
</style>
