---
import { url, media } from "../lib/text";
interface Props {
  work: { title: string; slug: string; thumbnail: string; services?: string[] };
  eager?: boolean;
}
const { work, eager = false } = Astro.props;
---

<a class="work-card tile reveal" href={url(`/works/${work.slug}`)} data-services={(work.services ?? []).join(" ")}>
  <img src={media(work.thumbnail)} alt={work.title} loading={eager ? "eager" : "lazy"} />
  <span class="work-card__overlay" aria-hidden="true">
    <span class="h3">{work.title}</span>
    <span class="upper underline">View project</span>
  </span>
</a>

<style>
  .work-card {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--bg);
  }
  /* Same look as an opened Services card. There is no separate white layer over the image
     (that caused a hairline at the edges on 125%/150% screens): the image itself fades out
     on the white card, which gives the same translucent-white result. */
  .work-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 20px 20px;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .work-card img {
    transition: transform 0.6s var(--ease), opacity 0.35s;
  }
  .work-card:hover img,
  .work-card:focus-visible img {
    opacity: var(--fade-to);
  }
  .work-card:hover .work-card__overlay,
  .work-card:focus-visible .work-card__overlay {
    opacity: 1;
  }
</style>
