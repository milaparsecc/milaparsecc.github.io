---
/* Category filter for a grid of WorkCards. Used on the homepage (Selected Works) and on /works.
   showAll=false hides the "All works" button; initial = slug of the category selected on load
   (the page must render cards outside that category with hidden={true}).
   mode "featured": "All works" shows only projects with showOnHomepage; a category shows every project in it.
   mode "all":      "All works" shows every project.
   Categories without any project are hidden.
   ?work=<slug or its start> in the URL opens that tab (e.g. /?work=social, /works?work=packaging). */
import services from "../data/services.json";
import works from "../data/works.json";
interface Props { target: string; mode?: "featured" | "all"; showAll?: boolean; initial?: string; categories?: string[]; }
const { target, mode = "all", showAll = true, initial = "all", categories } = Astro.props;
const used = categories
  ? services.filter((s) => categories.includes(s.slug))
  : services.filter((s) => works.some((w) => w.services.includes(s.slug)));
---

<div class="filters" data-work-filter={target} data-mode={mode} role="group" aria-label="Filter works by service">
  {showAll && (
    <button class:list={["filter upper", { "is-active": initial === "all" }]} type="button" data-filter="all" aria-pressed={String(initial === "all")}>All works</button>
  )}
  {used.map((s) => (
    <button class:list={["filter upper", { "is-active": initial === s.slug }]} type="button" data-filter={s.slug} aria-pressed={String(initial === s.slug)}>{s.title}</button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-work-filter]").forEach((group) => {
    const grid = document.getElementById(group.dataset.workFilter!);
    if (!grid) return;
    const featuredOnly = group.dataset.mode === "featured";
    const cards = grid.querySelectorAll<HTMLElement>(".work-card");
    const empty = grid.parentElement?.querySelector<HTMLElement>("[data-empty]");
    const buttons = group.querySelectorAll<HTMLButtonElement>(".filter");
    const apply = (f: string) => {
      let shown = 0;
      cards.forEach((c) => {
        const match = f === "all"
          ? !featuredOnly || c.dataset.featured === "true"
          : (c.dataset.services ?? "").split(" ").includes(f);
        c.hidden = !match;
        if (match) { shown++; c.classList.add("is-visible"); }
      });
      if (empty) empty.hidden = shown > 0;
    };
    const select = (btn: HTMLButtonElement) => {
      buttons.forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-pressed", String(b === btn));
      });
      apply(btn.dataset.filter!);
    };
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        select(btn);
        // Keep the chosen tab in the address, so a link like /?work=social opens it
        const url = new URL(location.href);
        url.searchParams.set("work", btn.dataset.filter!);
        history.replaceState(null, "", url);
      })
    );
    // ?work=<service slug or its first word>: e.g. ?work=social, ?work=packaging, ?work=spaces
    const wanted = new URLSearchParams(location.search).get("work")?.toLowerCase().trim();
    if (wanted) {
      const btn = [...buttons].find((b) => b.dataset.filter === wanted)
        ?? [...buttons].find((b) => b.dataset.filter!.startsWith(wanted));
      if (btn) {
        select(btn);
        if (!location.hash) group.closest("section")?.scrollIntoView();
      }
    }
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  .filter {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 4px;
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--fs-ui);
    letter-spacing: -0.04em;
    cursor: pointer;
    transition: color 0.2s;
  }
  .filter:hover,
  .filter.is-active {
    color: var(--text);
  }
  .filter.is-active {
    border-bottom-color: var(--text);
  }
  :global(.work-card[hidden]) {
    display: none;
  }
</style>
