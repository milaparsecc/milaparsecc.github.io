---
import site from "../data/site.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Preview image for links shared in messengers / LinkedIn ("/media/..."); defaults to seo.image */
  image?: string;
}
const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.seo.title;
const pageDescription = description ?? site.seo.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const absolute = (p: string) => (/^https?:/.test(p) ? p : new URL(base + p, Astro.site).href);
const ogImage = absolute(image || site.seo.image);
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  { label: "Works", href: "/works" },
  { label: "Expertise", href: "/#services" },
  { label: "About", href: "/#about" },
  ...(site.cv.enabled ? [{ label: "CV", href: site.cv.url, external: true }] : []),
];
const isActive = (href: string): boolean => !href.includes("#") && path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Reveal animations only run with JS; without it (and when printing) everything is visible -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {site.fonts?.adobeKitId && (
      <link rel="stylesheet" href={`https://use.typekit.net/${site.fonts.adobeKitId}.css`} />
    )}
  </head>
  <body>
    <header class="nav" data-open="false">
      <div class="nav__bar container">
        <div class="nav__left">
          <a class="nav__logo" href={`${base}/`} style={`font-family: "${site.fonts.signatureFamily}", cursive`}>{site.logo}</a>
          <nav class="nav__links" aria-label="Main">
            {nav.map((l) => (
              <a href={`${base}${l.href}`} class:list={["nav__link", { "is-active": !l.external && isActive(l.href) }]} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>
                {l.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="nav__right">
          <a class="nav__cta" href={`${base}/contact`}>Get in touch</a>
          <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
            <span class="nav__toggle-open">Menu</span>
            <span class="nav__toggle-close">Close</span>
          </button>
        </div>
      </div>
      <div class="nav__mobile" id="mobile-menu">
        {nav.map((l) => (
          <a href={`${base}${l.href}`} class="nav__mobile-link" target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>{l.label}</a>
        ))}
        <a href={`${base}/contact`} class="nav__mobile-link">Get in touch</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <a class="footer__heading h2" href={`${base}/contact`}>{site.footer.heading}</a>
        <div class="footer__row">
          <div class="footer__links">
            <a class="upper" href={`mailto:${site.contact.email}`}>Email</a>
            {site.contact.socials[0] && (
              <a class="upper" href={site.contact.socials[0].url} target="_blank" rel="noopener">
                {site.contact.socials[0].name}
              </a>
            )}
          </div>
          <div class="footer__links">
            {site.analytics?.gaId && <button class="upper footer__cookies" type="button" data-cookie-settings>Cookies</button>}
            <span class="upper">{site.footer.copyright}</span>
          </div>
        </div>
      </div>
    </footer>

    {site.analytics?.gaId && (
      <>
        <!-- Cookie consent: Google Analytics loads only after "Accept" (choice kept in localStorage) -->
        <div class="cookie" id="cookie-banner" role="dialog" aria-label="Cookies" hidden>
          <p class="cookie__text">I use Google Analytics cookies to see which projects visitors look at. You can change your choice anytime under “Cookies” at the bottom of the page.</p>
          <div class="cookie__actions">
            <button class="nav__cta" type="button" data-cookie="yes">Accept</button>
            <button class="upper cookie__decline" type="button" data-cookie="no">Decline</button>
          </div>
        </div>
        <script is:inline define:vars={{ gaId: site.analytics.gaId }}>
          (() => {
            const KEY = "mp-cookie-consent";
            const banner = document.getElementById("cookie-banner");
            const get = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
            const set = (v) => { try { localStorage.setItem(KEY, v); } catch {} };
            const loadGA = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              const s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", gaId);
            };
            const choice = get();
            if (choice === "yes") loadGA();
            else if (!choice) banner.hidden = false;
            banner.querySelectorAll("[data-cookie]").forEach((b) =>
              b.addEventListener("click", () => {
                const v = b.dataset.cookie;
                const was = get();
                set(v);
                banner.hidden = true;
                if (v === "yes") loadGA();
                else if (was === "yes") {
                  // Withdrawn consent: remove GA cookies and reload without analytics
                  document.cookie.split(";").map((c) => c.trim().split("=")[0]).filter((n) => n.startsWith("_ga"))
                    .forEach((n) => { document.cookie = n + "=; Max-Age=0; path=/"; document.cookie = n + "=; Max-Age=0; path=/; domain=." + location.hostname; });
                  location.reload();
                }
              })
            );
            document.querySelectorAll("[data-cookie-settings]").forEach((b) => b.addEventListener("click", () => (banner.hidden = false)));
          })();
        </script>
      </>
    )}

    <script>
      // Solid background once the page is scrolled
      const header = document.querySelector<HTMLElement>(".nav");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 10);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
      const setOpen = (open: boolean) => {
        header!.dataset.open = String(open);
        toggle?.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
      };
      toggle?.addEventListener("click", () => setOpen(header?.dataset.open !== "true"));
      document.querySelectorAll(".nav__mobile-link").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      // Fade-in on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      addEventListener("beforeprint", () =>
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"))
      );
    </script>
  </body>
</html>
