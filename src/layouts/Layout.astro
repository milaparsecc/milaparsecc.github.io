---
import site from "../data/site.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.seo.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  { label: "Works", href: "/works" },
  { label: "Services", href: "/#services" },
  { label: "About", href: "/#about" },
];
const isActive = (href: string) => !href.includes("#") && path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.seo.description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {site.fonts?.adobeKitId && (
      <link rel="stylesheet" href={`https://use.typekit.net/${site.fonts.adobeKitId}.css`} />
    )}
  </head>
  <body>
    <header class="nav" data-open="false">
      <div class="nav__bar container">
        <div class="nav__left">
          <a class="nav__logo" href={`${base}/`} style={`font-family: "${site.fonts.signatureFamily}", cursive`}>{site.logo}</a>
          <nav class="nav__links" aria-label="Main">
            {nav.map((l) => (
              <a href={`${base}${l.href}`} class:list={["nav__link", { "is-active": isActive(l.href) }]}>
                {l.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="nav__right">
          <a class="nav__cta" href={`${base}/contact`}>Get in touch</a>
          <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
            <span class="nav__toggle-open">Menu</span>
            <span class="nav__toggle-close">Close</span>
          </button>
        </div>
      </div>
      <div class="nav__mobile" id="mobile-menu">
        {nav.map((l) => (
          <a href={`${base}${l.href}`} class="nav__mobile-link">{l.label}</a>
        ))}
        <a href={`${base}/contact`} class="nav__mobile-link">Get in touch</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <a class="footer__heading h2" href={`${base}/contact`}>{site.footer.heading}</a>
        <div class="footer__row">
          <div class="footer__links">
            <a class="upper" href={`mailto:${site.contact.email}`}>Email</a>
            {site.contact.socials[0] && (
              <a class="upper" href={site.contact.socials[0].url} target="_blank" rel="noopener">
                {site.contact.socials[0].name}
              </a>
            )}
          </div>
          <span class="upper">{site.footer.copyright}</span>
        </div>
      </div>
    </footer>

    <script>
      // Solid background once the page is scrolled
      const header = document.querySelector<HTMLElement>(".nav");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 10);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
      const setOpen = (open: boolean) => {
        header!.dataset.open = String(open);
        toggle?.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
      };
      toggle?.addEventListener("click", () => setOpen(header?.dataset.open !== "true"));
      document.querySelectorAll(".nav__mobile-link").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      // Fade-in on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
