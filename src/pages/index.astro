---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import WorkFilter from "../components/WorkFilter.astro";
import site from "../data/site.json";
import works from "../data/works.json";
import services from "../data/services.json";
import { url, media } from "../lib/text";

---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__photo">
      {site.hero.video ? (
        <video poster={media(site.hero.videoPoster || site.hero.image)} autoplay muted loop playsinline preload="auto" aria-label="Selected works by Mila Parsec">
          {site.hero.videoMobile && <source src={media(site.hero.videoMobile)} type="video/mp4" media="(max-width: 809.98px)" />}
          <source src={media(site.hero.video)} type="video/mp4" />
        </video>
      ) : (
        <img src={media(site.hero.image)} alt={site.hero.imageAlt} fetchpriority="high" />
      )}
    </div>
    <div class="hero__content">
      <div class="hero__head">
        <h1 class="hero__name">{site.name}</h1>
        {site.fonts?.adobeKitId ? (
          <p class="hero__signature-text" aria-label={site.hero.signatureText} style={`font-family: "${site.fonts.signatureFamily}", cursive`}>
            {site.hero.signatureText}
          </p>
        ) : (
          <img class="hero__signature" src={media(site.hero.signature)} alt={site.hero.signatureText} width="600" height="78" />
        )}
      </div>
      <div class="hero__portrait-wrap">
        <img class="hero__portrait" src={media(site.hero.portrait)} alt={`Portrait of ${site.name}`} width="328" height="410" />
      </div>
      <p class="hero__intro">{site.hero.intro}</p>
    </div>
  </section>

  <!-- Selected works -->
  <section class="section container" id="works">
    <div class="section__head">
      <h2 class="h2">Selected Works</h2>
      <a class="upper underline small-link" href={url("/works")}>See all works</a>
    </div>
    <div class="works-filter">
      <WorkFilter target="works-home" mode="featured" />
    </div>
    <div class="works-grid" id="works-home">
      {works.map((w) => <WorkCard work={w} hidden={!w.showOnHomepage} />)}
    </div>
    <p class="upper muted works-empty" data-empty hidden>No works in this category yet</p>
  </section>

  <!-- Services -->
  <section class="section container" id="services">
    <div class="section__head">
      <h2 class="h2">Services</h2>
    </div>
    <div class="services-grid">
      {services.map((s) => (
        <button class="service tile reveal" type="button" aria-expanded="false">
          {s.image ? <img src={media(s.image)} alt="" loading="lazy" /> : <span class="service__pattern" />}
          <span class="service__head">
            <span class="h3">{s.title}</span>
            <span class="service__plus" aria-hidden="true" />
          </span>
          {s.description && <span class="service__desc">{s.description}</span>}
        </button>
      ))}
    </div>
  </section>

  <!-- About -->
  <section class="section container about" id="about">
    <div class="about__text">
      <h2 class="h2">About me</h2>
      <dl class="about__rows">
        {site.about.rows.map((r) => (
          <div class="about__row">
            <dt class="small-upper">{r.label}</dt>
            <dd>
              {r.text && <p>{r.text}</p>}
              {r.list && (
                <ul>
                  {r.list.map((li) => <li>{li}</li>)}
                </ul>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="about__photo tile reveal">
      <img src={media(site.about.photo)} alt={`Portrait of ${site.name}`} loading="lazy" />
    </div>
  </section>
</Layout>

<script>
  // Mouse: descriptions open on hover (CSS). Touch screens have no hover, so a tap toggles them.
  const touch = window.matchMedia("(hover: none)").matches;
  document.querySelectorAll<HTMLButtonElement>(".service").forEach((card) => {
    card.addEventListener("click", () => {
      if (!touch) return;
      const open = card.getAttribute("aria-expanded") === "true";
      card.setAttribute("aria-expanded", String(!open));
    });
  });
</script>

<style>
  /* Hero: 50/50 split, photo bleeds to the edge, content centered in the right half.
     Hierarchy: big name (with the script signature tucked under it) → large portrait → intro. */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1fr);
    height: 100vh;
    height: 100svh;
    min-height: 640px;
    padding-top: var(--nav-h); /* hero starts under the nav bar */
  }
  .hero__photo {
    position: relative;
    background: var(--tile);
    overflow: hidden;
  }
  .hero__photo img,
  .hero__photo video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__content {
    min-height: 0;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 40px from the nav on top, 40px (= page margin) under the intro */
    padding: var(--pad-x);
    text-align: center;
  }

  /* Name + signature lockup: both scale with the column so they always fit on one line */
  .hero__head {
    --name: min(132px, calc(100cqi / 4.4));
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--name);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .hero__signature-text {
    position: relative;
    margin-top: calc(var(--name) * -0.07);
    color: var(--accent);
    font-size: min(40px, calc(100cqi / 18));
    line-height: 1.3;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .hero__signature {
    width: min(600px, 100%);
    height: auto;
    margin-top: 8px;
  }

  /* Portrait takes the space left between the name and the intro */
  .hero__portrait-wrap {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
  }
  .hero__portrait {
    height: 100%;
    max-height: 640px;
    width: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero__intro {
    margin-top: 28px;
    max-width: 440px;
    text-wrap: balance; /* body text: inherits 18px / 120% / -4% */
  }

  @media (max-width: 809.98px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
      min-height: 0;
    }
    .hero__photo {
      aspect-ratio: 4 / 5;
    }
    .hero__content {
      padding: 48px var(--pad-x) 8px;
    }
    .hero__portrait-wrap {
      flex: none;
      margin-top: 32px;
    }
    .hero__portrait {
      height: auto;
      width: min(360px, 100%);
    }
    .hero__intro {
      margin-top: 24px;
    }
  }

  .small-link {
    margin-bottom: 10px;
  }

  .works-filter {
    margin-bottom: 24px;
  }
  .works-empty {
    margin-top: 24px;
  }
  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
  .service {
    display: block;
    color: #fff;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: default;
  }
  @media (hover: none) { .service { cursor: pointer; } }
  .service img {
    position: absolute;
    inset: 0;
  }
  .service__pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      #f2f2f2 0 10px,
      #ebebeb 10px 20px
    );
  }
  .service__head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    z-index: 2;
  }
  .service__plus {
    position: relative;
    width: 14px;
    height: 14px;
    transition: transform 0.3s;
  }
  .service__plus::before,
  .service__plus::after {
    content: "";
    position: absolute;
    background: currentColor;
  }
  .service__plus::before { left: 0; right: 0; top: 50%; height: 1px; }
  .service__plus::after { top: 0; bottom: 0; left: 50%; width: 1px; }
  .service[aria-expanded="true"] .service__plus, .service:hover .service__plus, .service:focus-visible .service__plus { transform: rotate(45deg); }
  .service[aria-expanded="true"] .service__head,
  .service:hover .service__head,
  .service:focus-visible .service__head,
  .service:not(:has(img)) .service__head { color: var(--text); }
  .service__head { text-shadow: 0 1px 10px rgba(0, 0, 0, 0.25); }
  .service[aria-expanded="true"] .service__head,
  .service:hover .service__head,
  .service:focus-visible .service__head,
  .service:not(:has(img)) .service__head { text-shadow: none; }

  .service__desc {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .service[aria-expanded="true"] .service__desc,
  .service:hover .service__desc,
  .service:focus-visible .service__desc {
    opacity: 1;
  }
  .service { background: var(--bg); }
  .service img { transition: transform 0.6s var(--ease), opacity 0.35s; }
  .service[aria-expanded="true"] img, .service:hover img, .service:focus-visible img { opacity: var(--fade-to); }

  .about {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 25%);
    gap: 60px;
    align-items: start;
  }
  .about__rows {
    margin: 32px 0 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .about__row {
    display: grid;
    grid-template-columns: minmax(160px, 20%) minmax(0, 440px);
    gap: 40px;
  }
  .about__row dd {
    margin: 0;
  }
  .about__photo {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 1199.98px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .about { grid-template-columns: 1fr; }
    .about__photo { max-width: 420px; order: -1; }
  }
  @media (max-width: 809.98px) {
    .works-grid,
    .services-grid { grid-template-columns: 1fr; }
    .about__row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
