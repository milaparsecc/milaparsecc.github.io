---
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";
import works from "../../data/works.json";
import services from "../../data/services.json";
import { richText, media } from "../../lib/text";

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
const serviceNames = work.services
  .map((slug) => services.find((s) => s.slug === slug)?.title)
  .filter(Boolean);

// "Next projects": the ones chosen in works.json, otherwise the following projects in the list.
const idx = works.findIndex((w) => w.slug === work.slug);
const chosen = work.nextProjects
  .map((slug) => works.find((w) => w.slug === slug))
  .filter((w): w is (typeof works)[number] => Boolean(w));
const next = (chosen.length
  ? chosen
  : [1, 2, 3].map((n) => works[(idx + n) % works.length]).filter((w) => w.slug !== work.slug)
).slice(0, 3);

const meta = [
  { label: "Services", value: serviceNames },
  { label: "Client", value: work.client ? [work.client] : [] },
  { label: "Location", value: work.location ? [work.location] : [] },
  { label: "Year", value: work.year ? [work.year] : [] },
].filter((m) => m.value.length);

const cover = work.cover || work.thumbnail;
// A gallery item can be a single image (full width) or a list of images shown side by side
const hasRows = work.gallery.some((g: unknown) => Array.isArray(g));
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Layout title={work.title} description={work.description.replace(/\*\*/g, "").slice(0, 160) || undefined}>
  <article class="section container page-top project">
    <h1 class="h1">{work.title}</h1>

    <div class="project__cover tile">
      <img src={media(cover)} alt={work.title} />
    </div>

    {(meta.length > 0 || work.description) && (
      <div class="project__info">
        <dl class="project__meta">
          {meta.map((m) => (
            <div>
              <dt class="small-upper">{m.label}</dt>
              <dd>{m.value.map((v) => <span>{v}</span>)}</dd>
            </div>
          ))}
        </dl>
        <div class="project__desc">
          {work.description && (
            <>
              <p class="small-upper">Info</p>
              <div class="rich" set:html={richText(work.description)} />
            </>
          )}
          {work.link && (
            <a class="underline project__link" href={work.link} target="_blank" rel="noopener">
              {work.linkText || "See live project"}
            </a>
          )}
        </div>
      </div>
    )}

    {(work.task || work.solution) && (
      <div class="project__case">
        {work.task && (
          <div>
            <p class="small-upper">Task</p>
            <div class="rich" set:html={richText(work.task)} />
          </div>
        )}
        {work.solution && (
          <div>
            <p class="small-upper">Solution</p>
            <div class="rich" set:html={richText(work.solution)} />
          </div>
        )}
      </div>
    )}

    <div class:list={["project__gallery", { "has-rows": hasRows }]}>
      {work.gallery.map((item) =>
        Array.isArray(item) ? (
          <div class="project__row" style={`--cols: ${item.length}`}>
            {item.map((src) => (isVideo(src)
              ? <video src={media(src)} autoplay muted loop playsinline />
              : <img src={media(src)} alt="" loading="lazy" />))}
          </div>
        ) : isVideo(item) ? (
          <video src={media(item)} autoplay muted loop playsinline />
        ) : (
          <img src={media(item)} alt="" loading="lazy" />
        )
      )}
    </div>
  </article>

  {next.length > 0 && (
    <section class="section container">
      <div class="section__head">
        <h2 class="h2">Next projects</h2>
      </div>
      <div class="next-grid">
        {next.map((w) => <WorkCard work={w} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  .project__cover {
    margin-top: 32px;
    aspect-ratio: 16 / 9;
  }
  .project__info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 60px 0 80px;
  }
  .project__meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .project__meta dd {
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
  }
  .project__desc {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 560px;
  }
  .rich :global(p + p) {
    margin-top: 1em;
  }
  .rich :global(strong) {
    font-weight: 600;
  }
  .project__link {
    align-self: flex-start;
    margin-top: 24px;
    font-size: var(--fs-ui);
  }
  .project__info:has(+ .project__case) { padding-bottom: 60px; }
  /* Task / Solution — same two columns as the info block above */
  .project__case {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 0 0 80px;
  }
  .project__case > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 560px;
  }
  .project__gallery {
    display: flex;
    flex-direction: column;
  }
  .project__gallery img,
  .project__gallery video {
    width: 100%;
    height: auto;
  }
  /* Photo cases with rows: same 20px gap as card grids. Seamless slide cases keep no gap. */
  .project__gallery.has-rows {
    gap: var(--gap);
  }
  .project__row {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gap);
  }
  .project__row img,
  .project__row video {
    height: 100%;
    object-fit: cover;
  }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
  @media (max-width: 809.98px) {
    .project__info { grid-template-columns: 1fr; padding: 40px 0 48px; }
    .project__case { grid-template-columns: 1fr; gap: 32px; padding-bottom: 48px; }
    .project__info:has(+ .project__case) { padding-bottom: 32px; }
    .next-grid { grid-template-columns: 1fr; }
    .project__row { grid-template-columns: 1fr; }
  }
</style>
