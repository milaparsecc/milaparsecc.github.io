<script>
  // Load the live site preview only on desktop, when it is near the viewport
  const live = document.querySelector<HTMLIFrameElement>(".site-preview__live");
  if (live && matchMedia("(min-width: 810px)").matches) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { live.src = live.dataset.src!; io.disconnect(); }
    }, { rootMargin: "800px 0px" });
    io.observe(live);
  }
</script>

<script>
  // Stories row: arrows scroll by one story, mouse drag scrolls, swipe/trackpad scroll natively
  document.querySelectorAll<HTMLElement>("[data-stories]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".stories__track")!;
    const prev = root.querySelector<HTMLButtonElement>(".stories__arrow--prev")!;
    const next = root.querySelector<HTMLButtonElement>(".stories__arrow--next")!;
    const step = () => {
      const img = track.querySelector<HTMLElement>(".stories__img")!;
      return img.offsetWidth + parseFloat(getComputedStyle(track).columnGap || "0");
    };
    const update = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); next.click(); }
      if (e.key === "ArrowLeft") { e.preventDefault(); prev.click(); }
    });
    // drag with the mouse (touch already scrolls natively)
    let startX = 0, startLeft = 0, dragging = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      dragging = true; startX = e.clientX; startLeft = track.scrollLeft;
      track.classList.add("is-dragging"); track.setPointerCapture(e.pointerId);
    });
    track.addEventListener("pointermove", (e) => { if (dragging) track.scrollLeft = startLeft - (e.clientX - startX); });
    const end = () => {
      if (!dragging) return;
      dragging = false; track.classList.remove("is-dragging");
      // settle on the nearest story
      const st = step(); track.scrollTo({ left: Math.round(track.scrollLeft / st) * st, behavior: "smooth" });
    };
    track.addEventListener("pointerup", end);
    track.addEventListener("pointercancel", end);
    update();
    // auto-scroll: one story every 4 s while the block is on screen; pauses only while pressed/dragged,
    // waits a little after the visitor scrolls by hand, loops back to the start at the end
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let inView = false, pressed = false, lastUser = 0;
    const AUTO = 4000;
    const userAct = () => { lastUser = Date.now(); };
    track.addEventListener("pointerdown", () => { pressed = true; userAct(); });
    window.addEventListener("pointerup", () => { if (pressed) { pressed = false; userAct(); } });
    track.addEventListener("touchstart", userAct, { passive: true });
    track.addEventListener("wheel", userAct, { passive: true });
    [prev, next].forEach((btn) => btn.addEventListener("click", userAct));
    new IntersectionObserver((es) => { inView = es[0].isIntersecting; }, { threshold: 0.5 }).observe(root);
    setInterval(() => {
      if (!inView || pressed || dragging || document.hidden || Date.now() - lastUser < AUTO * 1.5) return;
      const atEnd = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
      if (atEnd) track.scrollTo({ left: 0, behavior: "smooth" });
      else track.scrollBy({ left: step(), behavior: "smooth" });
    }, AUTO);
  });
</script>

<script>
  // Ad sets with more than 4 items: arrows scroll by one card, mouse drag, swipe/trackpad natively
  document.querySelectorAll<HTMLElement>("[data-set-scroll]").forEach((root) => {
    const row = root.querySelector<HTMLElement>(".project__row")!;
    const prev = root.querySelector<HTMLButtonElement>(".set-arrow--prev")!;
    const next = root.querySelector<HTMLButtonElement>(".set-arrow--next")!;
    const step = () => (row.firstElementChild as HTMLElement).offsetWidth + parseFloat(getComputedStyle(row).columnGap || "0");
    const update = () => {
      prev.disabled = row.scrollLeft < 4;
      next.disabled = row.scrollLeft + row.clientWidth > row.scrollWidth - 4;
    };
    prev.addEventListener("click", () => row.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => row.scrollBy({ left: step(), behavior: "smooth" }));
    row.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    let startX = 0, startLeft = 0, dragging = false;
    row.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      dragging = true; startX = e.clientX; startLeft = row.scrollLeft;
      row.classList.add("is-dragging"); row.setPointerCapture(e.pointerId);
    });
    row.addEventListener("pointermove", (e) => { if (dragging) row.scrollLeft = startLeft - (e.clientX - startX); });
    const end = () => {
      if (!dragging) return;
      dragging = false; row.classList.remove("is-dragging");
      const st = step(); row.scrollTo({ left: Math.round(row.scrollLeft / st) * st, behavior: "smooth" });
    };
    row.addEventListener("pointerup", end);
    row.addEventListener("pointercancel", end);
    update();
  });
</script>
