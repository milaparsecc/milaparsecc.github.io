---
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";
import works from "../../data/works.json";
import services from "../../data/services.json";
import { richText, media } from "../../lib/text";

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
const serviceNames = work.services
  .map((slug) => services.find((s) => s.slug === slug)?.title)
  .filter(Boolean);
// Services as links to /works filtered by that service
const serviceLinks = work.services
  .map((slug) => ({ slug, title: services.find((s) => s.slug === slug)?.title }))
  .filter((s) => s.title);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const deliverables = work.deliverables ? splitList(work.deliverables) : [];

// "Next projects": the ones chosen in works.json, otherwise the following projects in the list.
const idx = works.findIndex((w) => w.slug === work.slug);
const chosen = work.nextProjects
  .map((slug) => works.find((w) => w.slug === slug))
  .filter((w): w is (typeof works)[number] => Boolean(w));
// Always 3 cards: hand-picked ones first, then filled up with the next projects in the list
const next = [
  ...chosen,
  ...[1, 2, 3, 4, 5].map((n) => works[(idx + n) % works.length]),
].filter((w, i, all) => w.slug !== work.slug && all.findIndex((x) => x.slug === w.slug) === i).slice(0, 3);

// "a, b (x, y), c" -> ["A", "B (x, y)", "C"]: commas inside brackets stay
function splitList(s: string) {
  const out: string[] = []; let depth = 0, cur = "";
  for (const ch of s) {
    if (ch === "(") depth++;
    if (ch === ")") depth--;
    if (ch === "," && depth === 0) { out.push(cur); cur = ""; } else cur += ch;
  }
  out.push(cur);
  return out.map((x) => x.trim()).filter(Boolean).map((x) => x[0].toUpperCase() + x.slice(1));
}
const meta = [
  { label: "Role", value: (work as any).role ? [(work as any).role] : [] },
  { label: "Client", value: work.client ? [work.client] : [] },
  { label: "Year", value: work.year ? [work.year] : [] },
  { label: "Location", value: work.location ? [work.location] : [] },
  { label: "Services", value: serviceNames },
  { label: "Deliverables", value: work.deliverables ? splitList(work.deliverables) : [], wide: true },
].filter((m) => m.value.length);

const cover = work.cover || work.thumbnail;

// Lead text next to the name: the task if written, otherwise the one-line tagline.
// Lead next to the name: dedicated `lead`, else the task, else the tagline
const lead = work.lead || work.task || work.tagline;
// Everything else is shown under the lead
const hasConceptBlock = work.gallery.some((g: any) => g && typeof g === "object" && !Array.isArray(g) && g.type === "concept");
const more = [
  { label: "Context", text: work.description },
  { label: "Task", text: work.task && lead !== work.task ? work.task : "" },
  // Concept goes here unless the gallery already has a concept block (then it fills that block)
  { label: "Concept", text: hasConceptBlock ? "" : work.concept },
  { label: "Solution", text: work.solution },
].filter((m) => m.text);
// A gallery item can be a single image (full width) or a list of images shown side by side
// `seamless: true` on a work keeps the whole gallery gapless, rows included
const hasRows = !(work as any).seamless && work.gallery.some((g: any) => Array.isArray(g) || (g && (g.type === "set" || g.type === "heading")));
// A gallery item can also be { type: "concept", image, title, text }: logo left, text right (like the hero)
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
// Alt texts for gallery images: "<project> — image N"
const altName = [work.title, work.titleScript].filter(Boolean).join(" ");
let altN = 0;
const alt = () => `${altName} — image ${++altN}`;
// Changes every build, so the embedded site preview is never served from an old cache
const buildId = Date.now().toString(36);
---

<Layout title={[work.title, work.titleScript].filter(Boolean).join(" ")} description={work.tagline || work.description.replace(/\*\*/g, "").slice(0, 160) || undefined} image={[work.cover, work.thumbnail].find((s) => s && !s.endsWith(".gif"))}>
  <article class="section container page-top project">
    <div class="project__cover tile">
      {work.coverVideo ? (
        <video src={media(work.coverVideo)} poster={media(cover)} autoplay muted loop playsinline aria-label={work.title} />
      ) : (
        <img src={media(cover)} alt={work.title} />
      )}
    </div>

    <!-- Intro: name + lead, then details and Context / Task / Solution, all open -->
    <!-- Reading order: 1) name + lead  2) facts (left, sticky) + Context / Task / Solution (right) -->
    <div class="project__intro">
      <h1 class="h2 project__title">{work.title}{work.titleScript && <> <span class="script">{work.titleScript}</span></>}</h1>
      <div class="project__lead">{lead && <div set:html={richText(lead)} />}</div>

      <!-- Project passport: short facts as rows, then services (links) and deliverables as tags -->
      <aside class="project__side">
        {meta.filter((m) => !["Services", "Deliverables"].includes(m.label)).length > 0 && (
          <dl class="project__facts">
            {meta.filter((m) => !["Services", "Deliverables"].includes(m.label)).map((m) => (
              <div>
                <dt class="small-upper">{m.label}</dt>
                <dd>{m.value.join(", ")}</dd>
              </div>
            ))}
          </dl>
        )}
        {serviceLinks.length > 0 && (
          <div class="project__tags-group">
            <p class="small-upper">Services</p>
            <ul class="project__tags">
              {serviceLinks.map((s) => (
                <li><a class="tag tag--link" href={`${base}/works?work=${s.slug}`}>{s.title} <span aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
          </div>
        )}
        {deliverables.length > 0 && (
          <div class="project__tags-group">
            <p class="small-upper">Deliverables</p>
            <ul class="project__tags">
              {deliverables.map((d) => <li class="tag">{d}</li>)}
            </ul>
          </div>
        )}
      </aside>

      <div class="project__body">
        {more.map((m) => (
          <section class="project__block">
            <h2 class="small-upper">{m.label}</h2>
            <div class="rich" set:html={richText(m.text)} />
          </section>
        ))}
        {work.link && (
          <a class="upper underline project__link" href={work.link} target="_blank" rel="noopener">
            {work.linkText || "See live project"}
          </a>
        )}
      </div>
    </div>

    <div class:list={["project__gallery", { "has-rows": hasRows, "is-seamless": (work as any).seamless }]}>
      {work.gallery.map((item) =>
        Array.isArray(item) ? (
          <div class="project__row" style={`--cols: ${item.length}`}>
            {item.map((src) => (isVideo(src)
              ? <video src={media(src)} autoplay muted loop playsinline aria-label={alt()} />
              : <img src={media(src)} alt={alt()} loading="lazy" />))}
          </div>
        ) : typeof item === "object" && item.type === "heading" ? (
          <p class="small-upper project__chapter">{item.title}</p>
        ) : typeof item === "object" && item.type === "set" ? (
          <div class="project__set">
            <p class="small-upper">{item.title}</p>
            <div class="project__row" style={`--cols: ${item.items.length}`}>
              {item.items.map((src: string, i: number) => <img src={media(src)} alt={`${item.title} — ad ${i + 1}`} loading="lazy" />)}
            </div>
          </div>
        ) : typeof item === "object" && item.type === "about" ? (
          <div class="project__about">
            <img src={media(item.image)} alt={item.name || altName} loading="lazy" />
            <div class="project__about-text">
              <p class="small-upper">{item.title}</p>
              <h2 class="h2">{item.name}</h2>
              <p>{[item.caption, item.site].filter(Boolean).join(" · ")}</p>
            </div>
          </div>
        ) : typeof item === "object" && item.type === "ads" ? (
          <div class="ads">
            {item.label && <p class="small-upper ads__label">{item.label}</p>}
            <div class="ads__row">
              {item.items.map((ad: any, i: number) => (
                <div class="ad">
                  <div class="ad__head">
                    <img class="ad__avatar" src={media(item.avatar)} alt="" />
                    <span class="ad__who"><b>{item.handle}</b><small>Sponsored</small></span>
                    <span class="ad__dots" aria-hidden="true">···</span>
                  </div>
                  <img class="ad__img" src={media(ad.src)} alt={`${altName} — social ad ${i + 1}`} loading="lazy" />
                  <div class="ad__foot"><span>{item.handle}</span><span class="ad__cta">{ad.cta}</span></div>
                </div>
              ))}
            </div>
          </div>
        ) : typeof item === "object" && item.type === "stories" ? (
          <div class="stories" data-stories>
            <div class="stories__stage">
              <button class="stories__arrow stories__arrow--prev" type="button" aria-label="Previous story"><span aria-hidden="true">←</span></button>
              <div class="stories__phone">
                <div class="stories__bars" aria-hidden="true">
                  {item.items.map(() => <span><i /></span>)}
                </div>
                {item.handle && <p class="stories__handle">{item.handle}</p>}
                {item.items.map((s: string, i: number) => (
                  <img class={i === 0 ? "stories__img is-active" : "stories__img"} src={media(s)} alt={`${altName} — story ${i + 1}`} loading="lazy" />
                ))}
                <button class="stories__tap stories__tap--prev" type="button" aria-label="Previous story"></button>
                <button class="stories__tap stories__tap--next" type="button" aria-label="Next story"></button>
              </div>
              <button class="stories__arrow stories__arrow--next" type="button" aria-label="Next story"><span aria-hidden="true">→</span></button>
            </div>
            <p class="stories__hint small-upper">Tap to switch · hold to pause</p>
          </div>
        ) : typeof item === "object" && item.type === "site" ? (
          <div class="site-preview">
            <div class="site-preview__window">
              <span class="site-preview__bar" aria-hidden="true"><i /><i /><i /><span>{item.address}</span></span>
              <span class="site-preview__screen">
                {/* Desktop: the live site, scrollable right here. Phones: the self-scrolling screenshot. */}
                <iframe class="site-preview__live" data-src={`${media(item.url)}?embed=1&v=${buildId}`} title={`${altName} — website`} loading="lazy"></iframe>
                <a class="site-preview__shot" href={media(item.url)} target="_blank" rel="noopener" aria-label={item.button}>
                  <img src={media(item.image)} alt={`${altName} — website`} loading="lazy" />
                </a>
              </span>
            </div>
            <p class="site-preview__hint small-upper">Scroll inside the window to explore</p>
            <a class="site-preview__button upper" href={media(item.url)} target="_blank" rel="noopener">{item.button} <span aria-hidden="true">↗</span></a>
          </div>
        ) : typeof item === "object" && item.type === "feature" ? (
          <div class="project__concept project__feature">
            <img src={media(item.image)} alt={`${altName} — ${item.title}`} loading="lazy" />
            <div class="project__concept-text">
              {item.label && <p class="small-upper">{item.label}</p>}
              <h2 class="h2">{item.title}</h2>
              <div class="rich" set:html={richText(item.text)} />
              {item.detail && <img class="project__feature-detail" src={media(item.detail)} alt="" loading="lazy" />}
              {item.circles && (
                <div class="project__feature-circles">
                  {item.circles.map((c) => <img src={media(c)} alt="" loading="lazy" />)}
                </div>
              )}
            </div>
          </div>
        ) : typeof item === "object" && item.type === "concept" ? (
          <div class="project__concept">
            <img src={media(item.image)} alt={`${altName} logo`} loading="lazy" />
            <div class="project__concept-text">
              <h2 class="h2">{item.title}</h2>
              <div class="rich" set:html={richText(work.concept || item.text)} />
            </div>
          </div>
        ) : isVideo(item) ? (
          <video src={media(item)} autoplay muted loop playsinline aria-label={alt()} />
        ) : (
          <img src={media(item)} alt={alt()} loading="lazy" />
        )
      )}
    </div>
  </article>

  {next.length > 0 && (
    <section class="section container">
      <div class="section__head">
        <h2 class="h2">Next projects</h2>
      </div>
      <div class="next-grid">
        {next.map((w) => <WorkCard work={w} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  .project__cover {
    aspect-ratio: 16 / 9;
  }

  /* Intro grid, 1/3 + 2/3 (4 + 8 of 12 columns):
     row 1 — name | lead (what to read first)
     row 2 — facts (sticky) | Context / Task / Solution */
  .project__intro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    column-gap: var(--gap);
    row-gap: 48px;
    padding: 56px 0 80px;
    align-items: start;
  }
  .project__title { padding-right: 40px; }
  /* Lead: same family as body text (Inter), only larger — serif stays for headings */
  .project__lead {
    max-width: 800px;
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .project__lead :global(p + p) { margin-top: 0.8em; }

  /* Facts: quiet, compact, stay in view while the texts are read */
  .project__side {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    padding-right: 40px;
  }
  /* Facts: label | value rows with hairlines, like a spec sheet */
  .project__facts {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .project__facts > div {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .project__facts dd {
    margin: 0;
    font-size: var(--fs-ui);
  }
  .project__tags-group {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .project__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-label);
    line-height: 1.2;
  }
  .tag--link {
    border-color: var(--text);
    transition: background 0.2s, color 0.2s;
  }
  .tag--link:hover {
    background: var(--text);
    color: var(--bg);
  }

  /* Case texts: readable measure, generous leading, clear sections */
  .project__body {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .project__block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .project__block h2 { font-weight: 400; }
  .project__block .rich {
    line-height: 1.5;
    text-wrap: pretty;
  }
  .rich :global(p + p) {
    margin-top: 1em;
  }
  .rich :global(strong) {
    font-weight: 600;
  }
  .project__link {
    align-self: flex-start;
  }
  .project__gallery {
    display: flex;
    flex-direction: column;
  }
  .project__gallery img,
  .project__gallery video {
    width: 100%;
    height: auto;
  }
  /* Photo cases with rows: same 20px gap as card grids. Seamless slide cases keep no gap. */
  .project__gallery.is-seamless .project__row { gap: 0; }
  .project__gallery.has-rows {
    gap: var(--gap);
  }
  /* Concept: logo image left, white text block right — same 50/50 split as the hero */
  .project__concept {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .project__concept img {
    width: 100%;
    height: 100%;
    aspect-ratio: 8 / 9;
    object-fit: cover;
  }
  /* Feature blocks: two equal squares, like the hero on the homepage */
  .project__feature > img { aspect-ratio: 1 / 1; }
  .project__feature .project__concept-text { padding-left: 120px; }
  /* Small visual under the feature text (formula, highlights, sub-logo) */
  .project__concept .project__feature-detail {
    margin-top: 16px;
    width: 100%;
    max-width: 320px;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
  }
  .project__concept .project__feature-circles {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .project__concept .project__feature-circles img {
    flex: 0 1 80px;
    min-width: 0;
    width: 80px;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }
  .project__concept-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: 40px clamp(var(--pad-x), 8%, 120px);
    background: var(--bg);
  }
  /* Client card: small photo in the left third (same grid as the intro), caption at its bottom on the right */
  .project__about {
    display: grid;
    grid-template-columns: 1fr 2fr;
    column-gap: var(--gap);
    align-items: end;
    padding: 0 0 80px;
  }
  .project__about img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .project__about-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project__concept-text .rich {
    max-width: 440px;
    text-wrap: pretty;
  }
  /* Website preview: browser window, the page scrolls by itself (pauses on hover), button opens the live prototype */
  /* Social ads ({ type: "ads" }): a row of 4:5 ads shown as sponsored posts, on the page background */
  .ads { display: flex; flex-direction: column; gap: 16px; padding: 80px var(--pad-x); background: #141316 url("/media/rubin/site-bg-9761ad.jpg") center / cover; }
  .ads__label { color: rgba(255, 255, 255, 0.6); }
  .ads__row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .ad { background: #fff; color: #141316; border-radius: 12px; overflow: hidden; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45); }
  .ad__head { display: flex; align-items: center; gap: 8px; padding: 10px 12px; }
  .ads .ad .ad__avatar { width: 28px; height: 28px; aspect-ratio: 1; border-radius: 50%; flex: none; object-fit: cover; }
  .ad__who { display: grid; line-height: 1.2; font-size: 14px; min-width: 0; }
  .ad__who b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ad__who small { font-size: 12px; color: #6b6b6b; }
  .ad__dots { margin-left: auto; color: #6b6b6b; letter-spacing: 1px; }
  .ads .ad .ad__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .ad__foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; background: #f2f2f2; font-size: 14px; }
  .ad__foot span:first-child { color: #6b6b6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .ad__cta { flex: none; padding: 6px 12px; border-radius: 6px; background: #e0e0e0; font-weight: 600; }
  @media (max-width: 1023px) { .ads__row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 809px) {
    .ads { padding: 40px 20px; }
    .ads__row { gap: 12px; }
    .ad__foot span:first-child { display: none; }
    .ad__cta { flex: 1; text-align: center; }
  }

  /* Instagram-style story player (Rubin Catering) */
  .stories {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 80px var(--pad-x);
    background: #141316 url("/media/rubin/site-bg-9761ad.jpg") center / cover;
    color: #fff;
  }
  .stories__stage { display: flex; align-items: center; gap: 40px; }
  .stories__phone {
    position: relative;
    width: min(360px, 78vw);
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    overflow: hidden;
    background: #0d0d0d;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  .stories__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .stories__img.is-active { opacity: 1; }
  .stories__bars {
    position: absolute;
    z-index: 2;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
  }
  .stories__bars span { flex: 1; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .stories__bars i { display: block; height: 100%; width: 0; background: #fff; }
  .stories__bars span.is-done i { width: 100%; }
  .stories__bars span.is-active i { animation: story-progress 5s linear forwards; }
  .stories.is-paused .stories__bars span.is-active i { animation-play-state: paused; }
  @keyframes story-progress { from { width: 0; } to { width: 100%; } }
  .stories__handle {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 16px;
    font-size: 14px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  .stories__tap {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    width: 50%;
    background: none;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .stories__tap--prev { left: 0; width: 35%; }
  .stories__tap--next { right: 0; width: 65%; }
  .stories__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    background: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .stories__arrow:hover { background: #fff; color: #141316; }
  .stories__hint { color: rgba(255, 255, 255, 0.5); }
  @media (max-width: 809px) {
    .stories { padding: 40px 20px; gap: 24px; }
    .stories__arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stories__img { transition: none; }
  }
  .site-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 80px var(--pad-x);
    /* Rubin's own dark (#141316) with a faint glow of its red, so the block belongs to the case's palette */
    background: #141316 url("/media/rubin/site-bg-9761ad.jpg") center / cover;
