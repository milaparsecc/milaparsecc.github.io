<script>
  // Load the live site preview only on desktop, when it is near the viewport
  const live = document.querySelector<HTMLIFrameElement>(".site-preview__live");
  if (live && matchMedia("(min-width: 810px)").matches) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { live.src = live.dataset.src!; io.disconnect(); }
    }, { rootMargin: "800px 0px" });
    io.observe(live);
  }
</script>

<script>
  // Story player: auto-advance (5 s, driven by the progress bar animation), tap/arrows/swipe, hold to pause
  document.querySelectorAll<HTMLElement>("[data-stories]").forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLImageElement>(".stories__img")];
    const bars = [...root.querySelectorAll<HTMLElement>(".stories__bars span")];
    const n = imgs.length;
    let cur = 0;
    let inView = false;
    const show = (i: number) => {
      cur = (i + n) % n;
      imgs.forEach((im, k) => im.classList.toggle("is-active", k === cur));
      bars.forEach((b, k) => {
        b.classList.remove("is-active");
        b.classList.toggle("is-done", k < cur);
      });
      const bar = bars[cur];
      void bar.offsetWidth; // restart the animation
      bar.classList.add("is-active");
      // warm up the next image
      const next = imgs[(cur + 1) % n];
      if (next.loading === "lazy") next.loading = "eager";
    };
    bars.forEach((b) => b.querySelector("i")!.addEventListener("animationend", () => show(cur + 1)));
    const pause = (on: boolean) => root.classList.toggle("is-paused", on || !inView);
    root.querySelectorAll(".stories__tap--prev, .stories__arrow--prev").forEach((el) => el.addEventListener("click", () => show(cur - 1)));
    root.querySelectorAll(".stories__tap--next, .stories__arrow--next").forEach((el) => el.addEventListener("click", () => show(cur + 1)));
    // hold to pause (a long press must not also switch the story)
    const phone = root.querySelector<HTMLElement>(".stories__phone")!;
    let downAt = 0, downX = 0, held = false, swiped = false, timer = 0;
    phone.addEventListener("pointerdown", (e) => {
      downAt = Date.now(); downX = e.clientX; held = false; swiped = false;
      timer = window.setTimeout(() => { held = true; pause(true); }, 250);
    });
    const up = (e: PointerEvent) => {
      clearTimeout(timer);
      if (held) { pause(false); }
      const dx = e.clientX - downX;
      if (Math.abs(dx) > 40 && Date.now() - downAt < 600) { swiped = true; show(cur + (dx < 0 ? 1 : -1)); }
    };
    phone.addEventListener("pointerup", up);
    phone.addEventListener("pointercancel", () => { clearTimeout(timer); pause(false); });
    phone.addEventListener("click", (e) => { if (held || swiped) { e.stopPropagation(); e.preventDefault(); held = false; swiped = false; } }, true);
    new IntersectionObserver((es) => { inView = es[0].isIntersecting; pause(false); }, { threshold: 0.4 }).observe(root);
    root.classList.add("is-paused");
    show(0);
  });
</script>

