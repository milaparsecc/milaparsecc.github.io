---
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";
import works from "../../data/works.json";
import WorkFilter from "../../components/WorkFilter.astro";
---

<Layout title="Works">
  <section class="section container page-top">
    <h1 class="h1">Works</h1>

    <div class="filters-wrap">
      <WorkFilter target="works-all" mode="all" />
    </div>

    <div class="grid" id="works-all">
      {works.map((w, i) => <WorkCard work={w} eager={i < 3} />)}
    </div>
    <p class="empty upper muted" data-empty hidden>No works matching this filter</p>
  </section>
</Layout>


<style>
  .filters-wrap {
    margin: 40px 0;
  }
  /* Same grid as Selected Works on the homepage: 2 columns, 20px gap in both directions */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
  }
  @media (max-width: 809.98px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
